# Optional. Leave unset in development: Vite proxies /api to the backend.
# Set when the API is served from a different origin than the frontend (and add that origin to CORS_ORIGINS).
# VITE_API_BASE_URL=http://127.0.0.1:8080

# Where the dev-server proxy forwards /api (default shown)
# VITE_BACKEND_URL=http://127.0.0.1:8080
