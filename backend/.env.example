# ====================================================================
# HR Demo Portal - Onboarding API - Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env.
# A system whose credentials are left blank is reported as "not configured"
# and its pipeline step is marked "skipped" (nothing is simulated).
# ====================================================================

# --- Application -----------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8080
# Comma separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Verify TLS certificates for outbound calls (disable only for self-signed lab instances)
VERIFY_SSL=true

# --- 1. ServiceNow (Service Catalog / ITSM) --------------------------
SN_INSTANCE_URL=https://your-instance.service-now.com
SN_USERNAME=
SN_PASSWORD=
SN_CATALOG_ITEM_SYS_ID=

# --- 2. AutomationEdge T4 (RPA) --------------------------------------
AE_SERVER_URL=https://t4.automationedge.com/aeengine
AE_ORG_CODE=
AE_USERNAME=
AE_PASSWORD=
AE_USER_ID=
AE_SOURCE=AutomationEdge HelpDesk
# Workflow names (defaults shown)
AE_WORKFLOW_GET_EMP_DETAILS=HR Demo Get Employee Details
AE_WORKFLOW_MANAGEMENT_APPROVAL=HR Demo Management Approval
AE_WORKFLOW_CREATE_AD_ACCOUNT=HR Demo AD user creation and Assign role
AE_WORKFLOW_O365_USER_CREATION=HR Demo O365 User Creation
AE_WORKFLOW_ADD_EMP_ORANGEHRM=HR Demo Add emp OrangeHRM
AE_WORKFLOW_CREATE_LAPTOP_REQUEST=HR Demo Create Laptop Request
AE_WORKFLOW_SEND_MAIL=HR Demo Send mail
AE_WORKFLOW_DOCUMENT_VERIFICATION=HR Demo Document Verification
# Offboarding
AE_WORKFLOW_GET_EXIT_DETAILS=HR Demo Get Exit Details
AE_WORKFLOW_EXIT_MANAGEMENT_APPROVAL=HR Demo Exit Management Approval
AE_WORKFLOW_AD_USER_DISABLE=HR Demo AD user disable
AE_WORKFLOW_O365_USER_OFFBOARDING=HR Demo O365 User Offboarding
AE_WORKFLOW_TERMINATE_EMP_ORANGEHRM=HR Demo Terminate emp OrangeHRM
AE_WORKFLOW_ASSET_RETURN_REQUEST=HR Demo Asset Return Request
AE_WORKFLOW_EXIT_CLEARANCE=HR Demo Exit Clearance
AE_WORKFLOW_SEND_MAIL_OFFBOARDING=HR Demo Send mail Offboarding
# Leave & attendance workflows (no inputs, nothing returned; each must reach 'Complete' before the chat goes on)
AE_WORKFLOW_LEAVE_BALANCE=HR Demo Get Leave Balance
AE_WORKFLOW_LEAVE_CHECK=HR Demo Check Leave Request
AE_WORKFLOW_ASSIGN_LEAVE=HR Demo Assign Leave OrangeHRM
AE_WORKFLOW_ATTENDANCE_RECORDS=HR Demo Get Attendance Records
AE_WORKFLOW_PUNCH_IN=HR Demo Add Punch In OrangeHRM
AE_WORKFLOW_PUNCH_OUT=HR Demo Punch Out OrangeHRM
# Max seconds to wait for a single workflow to reach 'Complete' (otherwise the step fails and the chain stops)
AE_WORKFLOW_TIMEOUT_SECONDS=180

# --- 3. Microsoft 365 / Entra ID (Microsoft Graph) -------------------
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_DEFAULT_DOMAIN=yourdomain.com
# Optional fallback grant used only if client-credentials fails
O365_REFRESH_TOKEN=

# --- 4. OrangeHRM -----------------------------------------------------
ORANGEHRM_BASE_URL=http://your-orangehrm-host/orangehrm
ORANGEHRM_USERNAME=
ORANGEHRM_PASSWORD=
# Leave & Attendance demo: the time zone sent when the demo adds a punch in OrangeHRM (name must be known to OrangeHRM; offset in hours)
ORANGEHRM_TIMEZONE_NAME=Asia/Kolkata
ORANGEHRM_TIMEZONE_OFFSET=5.5

# --- 5. Outbound mail (offer letter) ---------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=HR Onboarding
# If blank, the offer letter is e-mailed to the candidate's own address
HR_NOTIFICATION_RECIPIENT=

# --- 6. Offer letter branding ----------------------------------------
COMPANY_NAME=AutomationEdge HR suite
COMPANY_ADDRESS=100 Innovation Way, Suite 500, San Francisco, CA 94105
OFFER_SIGNATORY_NAME=Elena Vance
OFFER_SIGNATORY_TITLE=Global Head of Talent Acquisition

# --- 7. Background jobs ----------------------------------------------
# Poll ServiceNow for requests approved directly inside ServiceNow
APPROVAL_POLLER_ENABLED=true
APPROVAL_POLL_INTERVAL_SECONDS=25
TASK_QUEUE_WORKERS=3

# --- 8. Agent demo pacing ---------------------------------------------
# Slow the demo down or speed it up. Applies to the Live Demo / Auto-Fill Demo pages.
# STEP_SCALE: multiplier for step and typing durations (1 = original speed, 2 = twice as slow, 0.5 = faster)
# MESSAGE_GAP_MS: pause after every chat message.  PHASE_GAP_MS: pause between phases.
# "Simulated" = Simulated only / the five scripted agents; "Live" = Onboarding "Run live".
DEMO_SIMULATED_STEP_SCALE=1.5
DEMO_SIMULATED_MESSAGE_GAP_MS=800
DEMO_SIMULATED_PHASE_GAP_MS=1500
# Simulated runs: how long the HR approval waits before it approves itself (you can click Approve sooner)
DEMO_SIMULATED_APPROVAL_WAIT_MS=8000
DEMO_LIVE_STEP_SCALE=1.5
DEMO_LIVE_MESSAGE_GAP_MS=800
DEMO_LIVE_PHASE_GAP_MS=1500

# --- 9. Document verification (OpenAI) ---------------------------------
# Used by the agent demo's Manual - Live mode to read the uploaded Aadhaar, PAN and salary slip and check that they are
# the right documents, that the names match the joining form and that the Aadhaar and PAN dates of birth agree.
# Leave OPENAI_API_KEY empty to switch this off (files are then only attached, not read).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=90
# 0-1: how similar the name on a document must be to the name on the form
DOCUMENT_NAME_MATCH_THRESHOLD=0.85

# --- 10. Offboarding ---------------------------------------------------
OFFBOARDING_NOTICE_PERIOD_DAYS=30
# Share of the monthly gross treated as "basic" (leave is encashed at the basic daily rate)
OFFBOARDING_BASIC_SHARE=0.5
