# ====================================================================
# HR Demo Portal - Onboarding API - Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env.
# A system whose credentials are left blank is reported as "not configured"
# and its pipeline step is marked "skipped" (nothing is simulated).
# ====================================================================

# --- Application -----------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8080
# Comma separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Verify TLS certificates for outbound calls (disable only for self-signed lab instances)
VERIFY_SSL=true

# --- Login (users are stored in a PostgreSQL database; create it in pgAdmin) -------
# false = the portal opens without a login. true = every page and /api call needs a signed-in user.
AUTH_ENABLED=false
# Long random text that signs the session cookie, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_SESSION_HOURS=12
# Set true only if every visitor reaches the portal over https
AUTH_COOKIE_SECURE=false
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# The first user in the table is made the admin; admins add the other users in the portal (Admin page).
# Command line alternative:  python -m app.tools.add_user alice --name "Alice Rao" --role admin

# --- Where records are kept ---------------------------------------------------
# json = the files in backend/data. postgres = the PG_* database above (the files are copied in once on first start and kept as a backup).
STORAGE_BACKEND=json

# (the table portal_users is created automatically on the first start)

# --- 1. ServiceNow (Service Catalog / ITSM) --------------------------
SN_INSTANCE_URL=https://your-instance.service-now.com
SN_USERNAME=
SN_PASSWORD=
SN_CATALOG_ITEM_SYS_ID=

# --- 2. AutomationEdge T4 (APA) --------------------------------------
AE_SERVER_URL=https://t4.automationedge.com/aeengine
AE_ORG_CODE=
AE_USERNAME=
AE_PASSWORD=
AE_USER_ID=
AE_SOURCE=AutomationEdge HelpDesk
# Workflow names (defaults shown)
AE_WORKFLOW_GET_EMP_DETAILS=HR Demo Get Employee Details
AE_WORKFLOW_MANAGEMENT_APPROVAL=HR Demo Management Approval
AE_WORKFLOW_CREATE_AD_ACCOUNT=HR Demo AD user creation and Assign role
AE_WORKFLOW_O365_USER_CREATION=HR Demo O365 User Creation
AE_WORKFLOW_ADD_EMP_ORANGEHRM=HR Demo Add emp OrangeHRM
AE_WORKFLOW_CREATE_LAPTOP_REQUEST=HR Demo Create Laptop Request
AE_WORKFLOW_DOCUMENT_VERIFICATION=HR Demo Document Verification
# Offboarding
AE_WORKFLOW_GET_EXIT_DETAILS=HR Demo Get Exit Details
AE_WORKFLOW_EXIT_MANAGEMENT_APPROVAL=HR Demo Exit Management Approval
AE_WORKFLOW_AD_USER_DISABLE=HR Demo AD user disable
AE_WORKFLOW_O365_USER_OFFBOARDING=HR Demo O365 User Offboarding
AE_WORKFLOW_TERMINATE_EMP_ORANGEHRM=HR Demo Terminate emp OrangeHRM
AE_WORKFLOW_ASSET_RETURN_REQUEST=HR Demo Asset Return Request
AE_WORKFLOW_EXIT_CLEARANCE=HR Demo Exit Clearance
AE_WORKFLOW_SEND_MAIL_OFFBOARDING=HR Demo Send mail Offboarding
# Leave & attendance workflows (no inputs, nothing returned; each must reach 'Complete' before the chat goes on)
AE_WORKFLOW_LEAVE_BALANCE=HR Demo Get Leave Balance
AE_WORKFLOW_LEAVE_CHECK=HR Demo Check Leave Request
AE_WORKFLOW_ASSIGN_LEAVE=HR Demo Assign Leave OrangeHRM
AE_WORKFLOW_ATTENDANCE_RECORDS=HR Demo Get Attendance Records
AE_WORKFLOW_PUNCH_IN=HR Demo Add Punch In OrangeHRM
AE_WORKFLOW_PUNCH_OUT=HR Demo Punch Out OrangeHRM
# Reimbursement workflows (no inputs, nothing returned; each runs after its own step and must reach 'Complete' before the chat goes on)
AE_WORKFLOW_READ_BILL=HR Demo Read Bill
AE_WORKFLOW_CHECK_REIMBURSEMENT_POLICY=HR Demo Check Reimbursement Policy
AE_WORKFLOW_SUBMIT_EXPENSE_CLAIM=HR Demo Submit Expense Claim
AE_WORKFLOW_CREATE_CLAIM=HR Demo Create Claim OrangeHRM
# HR policy & documents workflows (no inputs, nothing returned; each runs after its own step and must reach 'Complete' before the chat goes on)
AE_WORKFLOW_SEARCH_POLICY=HR Demo Search Policy
AE_WORKFLOW_GET_POLICY=HR Demo Get Policy Document
AE_WORKFLOW_ASK_POLICY=HR Demo Ask Policy Question
AE_WORKFLOW_ADDRESS_PROOF_LETTER=HR Demo Generate Address Proof Letter
AE_WORKFLOW_BANK_ACCOUNT_LETTER=HR Demo Generate Bank Account Opening Letter
# Payroll & salary workflows (no inputs, nothing returned; each runs BEFORE its document and must reach 'Complete' before the chat goes on)
AE_WORKFLOW_FETCH_SALARY=HR Demo Fetch Salary Details
AE_WORKFLOW_GENERATE_PAYSLIP=HR Demo Generate Payslip
AE_WORKFLOW_GENERATE_CTC=HR Demo Generate CTC Statement
AE_WORKFLOW_GENERATE_FORM16=HR Demo Generate Form 16
# Max seconds to wait for a single workflow to reach 'Complete' (otherwise the step fails and the chain stops)
AE_WORKFLOW_TIMEOUT_SECONDS=180

# --- 3. Microsoft 365 / Entra ID (Microsoft Graph) -------------------
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_DEFAULT_DOMAIN=yourdomain.com
# Optional fallback grant used only if client-credentials fails
O365_REFRESH_TOKEN=

# --- 4. HRMS ----------------------------------------------------------
# The portal has its own HR system (HRMS, served at /api/hrms); the demos always use it, and no settings are needed.
# Sign-in for it (also what AutomationEdge uses when it calls it):
HRMS_ADMIN_USERNAME=Admin
HRMS_ADMIN_PASSWORD=admin123
# Optional: where the HRMS pages open from the demo links (default: the first CORS_ORIGINS address + /hr/simulated/hrms)
HRMS_UI_URL=
# Optional: only if the portal reaches itself at another address than http://127.0.0.1:<PORT>/api/hrms
HRMS_BASE_URL=
# Leave & Attendance demo: the time zone sent when the demo adds a punch in the HRMS (name must be known to it; offset in hours)
ORANGEHRM_TIMEZONE_NAME=Asia/Kolkata
ORANGEHRM_TIMEZONE_OFFSET=5.5

# --- 5. Outbound mail (relieving letter) ---------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=HR Onboarding

# People e-mailed when someone asks for access on the login page (comma-separated). Empty = nobody is e-mailed.
ACCESS_APPROVER_EMAILS=
# The portal's public address, used for the link in that e-mail, e.g. https://s1.automationedge.com/hr
PORTAL_URL=
# If blank, the relieving letter is e-mailed to the employee's own address
HR_NOTIFICATION_RECIPIENT=

# --- 6. Letter branding (relieving letter) ----------------------------------------
COMPANY_NAME=AutomationEdge HR suite
COMPANY_ADDRESS=100 Innovation Way, Suite 500, San Francisco, CA 94105
OFFER_SIGNATORY_NAME=Elena Vance
OFFER_SIGNATORY_TITLE=Global Head of Talent Acquisition

# --- Knowledge base (HR Policy & Document agent: answers policy questions) ---
# The token is fetched with the project id and secret (GET /token) and renewed when it expires. Blank: questions fail with "not configured".
KM_BASE_URL=https://ac2.automationedge.com/km/api
KM_PROJECT_ID=
KM_PROJECT_SECRET=
KM_TIMEOUT_SECONDS=60

# --- 7. Background jobs ----------------------------------------------
# Poll ServiceNow for requests approved directly inside ServiceNow
APPROVAL_POLLER_ENABLED=true
APPROVAL_POLL_INTERVAL_SECONDS=25
TASK_QUEUE_WORKERS=3

# --- 8. Agent demo pacing ---------------------------------------------
# Slow the demo down or speed it up. Applies to the Live Demo / Auto-Fill Demo pages.
# STEP_SCALE: multiplier for step and typing durations (1 = original speed, 2 = twice as slow, 0.5 = faster)
# MESSAGE_GAP_MS: pause after every chat message.  PHASE_GAP_MS: pause between phases.
# "Simulated" = Simulated only / the five scripted agents; "Live" = Onboarding "Run live".
DEMO_SIMULATED_STEP_SCALE=1.5
DEMO_SIMULATED_MESSAGE_GAP_MS=800
DEMO_SIMULATED_PHASE_GAP_MS=1500
# Simulated runs: how long the HR approval waits before it approves itself (you can click Approve sooner)
DEMO_SIMULATED_APPROVAL_WAIT_MS=8000
DEMO_LIVE_STEP_SCALE=1.5
DEMO_LIVE_MESSAGE_GAP_MS=800
DEMO_LIVE_PHASE_GAP_MS=1500

# --- 9. Document verification (Google Gemini on Vertex AI) ---------------
# Used by the agent demo's Manual - Live mode to read the uploaded Aadhaar, PAN and salary slip, and the reimbursement bills.
# Sign-in is a Google Cloud service account: put its key file at backend/credentials/service-account.json (or point
# GOOGLE_CREDENTIALS_FILE at it). The service account needs the "Vertex AI User" role, and the Vertex AI API must be on in the project.
# Without the file this is switched off (files are then only attached, not read).
GOOGLE_CREDENTIALS_FILE=credentials/service-account.json
# Empty = the project_id inside the key file
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=90
# 0-1: how similar the name on a document must be to the name on the form
DOCUMENT_NAME_MATCH_THRESHOLD=0.85

# --- 10. Offboarding ---------------------------------------------------
OFFBOARDING_NOTICE_PERIOD_DAYS=30
# Share of the monthly gross treated as "basic" (leave is encashed at the basic daily rate)
OFFBOARDING_BASIC_SHARE=0.5
